# Required: model must support function calling.
OPEN_ROUTER_KEY=
OPEN_ROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Optional notification delivery
PUSHOVER_USER=
PUSHOVER_TOKEN=
# Runtime defaults
HOST=127.0.0.1
PORT=7860
# Use a fixed port in production; local runs try nearby ports if busy.
PORT_STRICT=false
API_TIMEOUT_SECONDS=45
MAX_INPUT_CHARS=4000
HISTORY_MESSAGES=20
MAX_TOOL_ROUNDS=4
MAX_OUTPUT_TOKENS=1200
CHAT_CONCURRENCY=4
QUEUE_SIZE=32
# Optional: absolute writable SQLite path; default digital-agent/runtime/agent.sqlite3
# DATABASE_PATH=/app/runtime/agent.sqlite3
# Set both for a private deployment; leave both blank for a public portfolio.
APP_AUTH_USER=
APP_AUTH_PASSWORD=
# Reverse proxy URL prefix, if any
ROOT_PATH=
# Optional external Postgres (recommended for free hosting). Keep credentials secret.
DATABASE_URL=
